#!/usr/bin/env bash
# Fake `docker` for orchestration tests of tools/m5_bench.sh: no Docker daemon, no GPU.
# "compose up" starts a local FakeDetector bevserve from the env file; state lives in $FAKE_STATE.
# FAKE_DOWN_FAIL=1 makes `compose down` fail and leave the service running (cleanup-failure test).
# FAKE_ENV_THREADS=N makes `inspect` report BEVSERVE_PREPROCESS_THREADS=N whatever was configured.
# The service is fake_server.py (the real app with a FakeDetector and optional failure knobs).
set -u
echo "docker $*" >> "$FAKE_STATE/calls.log"
IMAGE_ID=sha256:$(printf 'f%.0s' {1..64})
running() { [ -f "$FAKE_STATE/pid" ] && kill -0 "$(cat "$FAKE_STATE/pid")" 2>/dev/null; }
case "$1" in
  image)
    case "$*" in
      *"{{.Id}}"*) echo "$IMAGE_ID" ;;
      *"{{json .}}"*) echo "{\"Id\": \"$IMAGE_ID\", \"Created\": \"now\", \"Size\": 1, \"RepoTags\": [\"fake:tag\"], \"Config\": {\"Labels\": {}}}" ;;
    esac ;;
  run) exec "$FAKE_PY" - package ;;   # docker run --rm -i ... python - package < provenance.py
  inspect)
    case "$*" in
      *"{{.State.Pid}}"*) cat "$FAKE_STATE/pid" ;;
      *"{{.Id}}"*) echo "container$(cat "$FAKE_STATE/pid")" ;;   # a new id per `compose up`
      *".Config.Env"*)   # the environment compose gives the container (compose.yaml defaults to 0)
        grep '^BEVSERVE_' "$FAKE_STATE/env" | grep -v '^BEVSERVE_PREPROCESS_THREADS='
        echo "BEVSERVE_PREPROCESS_THREADS=${FAKE_ENV_THREADS:-$(sed -n 's/^BEVSERVE_PREPROCESS_THREADS=//p' "$FAKE_STATE/env" | tail -1)}"
        ;;
    esac ;;
  ps) if running && [[ "$*" == *"com.docker.compose.project="* ]]; then echo fakecontainer; fi ;;
  network) if running; then echo fakenetwork; fi ;;
  compose)
    case " $* " in
      *" up "*)
        envf=$(sed -E 's/.*--env-file ([^ ]+).*/\1/' <<< "$*")
        cp "$envf" "$FAKE_STATE/env"
        grep -q '^BEVSERVE_PREPROCESS_THREADS=' "$FAKE_STATE/env" || echo "BEVSERVE_PREPROCESS_THREADS=0" >> "$FAKE_STATE/env"
        set -a; . "$envf"; set +a
        BEVSERVE_PORT=$BEVSERVE_HOST_PORT setsid "$FAKE_PY" "$(dirname "$0")/fake_server.py" \
          >> "$FAKE_STATE/server.log" 2>&1 < /dev/null 3>&- 4>&- &   # no inherited pipes
        echo $! > "$FAKE_STATE/pid" ;;
      *" ps "*) if running; then echo fakecontainer; fi ;;
      *" logs "*) cat "$FAKE_STATE/server.log" 2>/dev/null ;;
      *" down "*)
        [ "${FAKE_DOWN_FAIL:-0}" = 1 ] && { echo "fake: down failed" >&2; exit 1; }
        if running; then kill "$(cat "$FAKE_STATE/pid")"; while running; do sleep 0.1; done; fi
        rm -f "$FAKE_STATE/pid" ;;
    esac ;;
  *) exit 0 ;;
esac
