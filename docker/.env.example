# Copy to docker/.env (git-ignored) and fill in. Never commit real paths or hashes you treat as private.
BEVSERVE_CHECKPOINT_DIR=/path/to/checkpoints
BEVSERVE_CHECKPOINT_FILE=bevdet-r50-cbgs.pth
BEVSERVE_CHECKPOINT_SHA256=<64 hex digits of the trusted checkpoint>
BEVSERVE_HOST_PORT=8000
BEVSERVE_GPU=0
# Parallel six-camera preprocessing (M6): 0 = serial (default), 12 = the verified and benchmarked value.
BEVSERVE_PREPROCESS_THREADS=0
